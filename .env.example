PANEL_TITLE=Cyrius Stream Control
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASSWORD=CHANGE_ME_NOW
PANEL_SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
PANEL_COOKIE_SECURE=false
FLUSSONIC_REQUEST_TIMEOUT=12

# Persistent encrypted server storage. Keep PANEL_SECRET_KEY unchanged after adding servers.
FLUSSONIC_SERVER_STORE=/app/data/servers.json

# Optional one-time seed. Servers can now be added in the panel itself.
# Existing values are imported only when the persistent server store is empty/new.
FLUSSONIC_SERVERS_JSON=[]

# Sessions monitoring
MONITOR_POLL_SECONDS=30
FLUSSONIC_SESSION_TIMEOUT=12
FLUSSONIC_SESSIONS_PATH=/streamer/api/v3/sessions
MONITOR_MAX_PAGES=1000
UPTIME_RESET_GAP=15
UPTIME_PRUNE_AFTER=600

# Persistent history, backups and audit log
PANEL_DATABASE=/app/data/panel.db
MONITOR_HISTORY_SECONDS=60
MONITOR_RETENTION_DAYS=30

# Source checks are manual-only in v5.12.1. Legacy scheduling variables are
# retained for compatibility but no background probe task is created.
SOURCE_CHECK_ENABLED=false
SOURCE_CHECK_SECONDS=300
SOURCE_CHECK_TIMEOUT=8
SOURCE_CHECK_CONCURRENCY=8
# false = ручная массовая проверка только основного сервера
SOURCE_CHECK_ALL_SERVERS=false

# Server load monitoring. Node Exporter URL is configured per server in the panel.
# If it is blank, the panel tries http://FLUSSONIC_HOST:9100/metrics.
# Runtime metrics and aggregate stream stats are fallback sources.
SERVER_LOAD_ENABLED=true
SERVER_LOAD_POLL_SECONDS=60
SERVER_NETWORK_POLL_SECONDS=1
SERVER_LOAD_HISTORY_SECONDS=60
SERVER_LOAD_CPU_WARNING=85
SERVER_LOAD_MEMORY_WARNING=85
SERVER_LOAD_DISK_WARNING=90
FLUSSONIC_RUNTIME_METRICS_PATHS=/streamer/api-v4/runtime/metrics,/streamer/api/v3/runtime/metrics,/runtime/metrics

# Cluster dashboard and encrypted cluster configuration
PANEL_CLUSTER_STORE=/app/data/cluster.json
CLUSTER_POLL_SECONDS=15
